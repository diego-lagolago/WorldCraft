# WorldCraft — nach .env kopieren und Werte eintragen.
# Keine echten Secrets committen.

# --- Laufzeit ---
NODE_ENV=development
# development | production
# Test-Login (T-008) nur lokal. worldcraft.lagolago.at ist Produktion.
# ENABLE_TEST_LOGIN=true und APP_ENV=production: die App darf nicht starten.
APP_ENV=development

# --- PostgreSQL (docker compose, lokal) ---
POSTGRES_USER=worldcraft
POSTGRES_PASSWORD=changeme
POSTGRES_DB=worldcraft
POSTGRES_PORT=5432
DATABASE_URL=postgresql://worldcraft:changeme@localhost:5432/worldcraft

# --- Better Auth (T-008) ---
# Geheimnis erzeugen mit: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Kanonische App-URL, kein Slash am Ende.
BETTER_AUTH_URL=http://localhost:3000

# --- Discord OAuth (T-008, Discord Developer Portal) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Test-Login (T-008; nur lokal, nie auf worldcraft.lagolago.at) ---
ENABLE_TEST_LOGIN=true

# --- Dateispeicher (Volume, kein S3) ---
# Lokal: Ordner im Repo (wird nicht committet).
# Coolify: Mount-Pfad des persistenten Volumes, z. B. /app/data/uploads
FILE_STORAGE_PATH=./data/uploads
